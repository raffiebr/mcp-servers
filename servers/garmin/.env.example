# Public origin of the server. Must be HTTPS in production.
BASE_URL=http://localhost:8000
# Google accounts allowed to use the connector and the setup page (comma-separated).
ALLOWED_EMAILS=her.account@gmail.com,your.test.account@gmail.com
# From Google Cloud Console > APIs & Services > Credentials (Web application client).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openssl rand -base64 48
JWT_SIGNING_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_ENCRYPTION_KEY=
# openssl rand -base64 48
SESSION_SECRET=
DATA_DIR=./data
TIMEZONE=Asia/Singapore
PORT=8000
