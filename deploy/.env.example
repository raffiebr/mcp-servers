# Copy to deploy/.env (gitignored). Read by the laptop scripts, and by docker compose
# on the VM. No secrets here: those live in Secret Manager (see create-secrets.sh).

# Your personal Google account and GCP project. The laptop scripts run gcloud as this
# account against this project, whatever your default gcloud config points at.
GCLOUD_ACCOUNT=you@gmail.com
PROJECT=your-personal-project-id
REGION=asia-southeast1
ZONE=asia-southeast1-b
VM=mcp-servers

# One public hostname per server, each with an A record pointing at the VM's static IP.
GARMIN_DOMAIN=garmin.example.com
